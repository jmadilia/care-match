PROJECT_NAME="FastAPI Backend"
ENVIRONMENT=local

# postgres:// and postgresql:// URLs from a hosted provider are accepted and rewritten to
# the postgresql+psycopg:// form. In a deployment, use the provider's pooled connection string.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5433/app

# Comma-separated list of allowed frontend origins
BACKEND_CORS_ORIGINS=http://localhost:3000

# The CRUD and strategy-run routers are an admin surface. Left unset they are mounted only
# when ENVIRONMENT=local, so a deployed instance exposes just health, comparisons, and intake.
# To enable them elsewhere, set both of these; requests then need an X-Admin-Key header.
# ADMIN_API_ENABLED=true
# ADMIN_API_KEY=change-me
